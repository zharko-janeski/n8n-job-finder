    {
      "parameters": {
        "jsCode": "const ranked = $json.ranked || [];\nconst today = new Date().toISOString().slice(0, 10);\nconst query = $('Prepare Scoring').first().json.query;\n\nreturn ranked.map(r => ({ json: {\n  Date: today,\n  Query: query,\n  Score: r.score,\n  Title: r.title,\n  Company: r.company,\n  Location: r.location || 'Remote',\n  URL: r.url,\n  Reason: r.reason\n}}));"
      },
