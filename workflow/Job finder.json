      ],
      "id": "5a957d47-53b2-4d43-9c88-c04555ed96d6",
      "name": "Qwen Extract Job"
    },
    {
      "parameters": {
        "jsCode": "// 1. Qwen's raw answer\nconst raw = ($json.choices[0].message.content || '').trim();\n\n// 2. Parse LABEL|value lines — tolerate LABEL:value too (8B models slip colons)\nconst fields = {};\nfor (const line of raw.split('\\n')) {\n  const m = line.match(/^\\s*([A-Z]+)\\s*[|:]\\s*(.+)$/);\n  if (m) fields[m[1]] = m[2].trim();\n}\n\n// 3. Essentials present? If not — the model ignored the format entirely\nif (!fields.TITLE || fields.FIT === undefined) {\n  throw new Error('Qwen ignored the format. Raw: ' + raw.slice(0, 300));\n}\n\nconst fit = parseInt(fields.FIT, 10) || 0;\n\n// 4. Build the phone message — same thresholds as the engine (🟢≥70 🟡≥40 🔴)\nconst emoji = fit >= 70 ? '🟢' : fit >= 40 ? '🟡' : '🔴';\nconst src = $('Prepare Extract').first().json;\n\nconst msg = '🔎 Job analysis:\\n\\n'\n  + `${emoji} ${fit}/100 — ${fields.TITLE}\\n`\n  + `🏢 ${fields.COMPANY || '—'}\\n`\n  + `💰 ${fields.SALARY || 'not listed'}\\n`\n  + `📍 ${fields.LOCATION || 'not listed'}\\n`\n  + `📄 ${fields.TYPE || 'not listed'}\\n\\n`\n  + `💬 ${fields.VERDICT || '—'}\\n`\n  + `🔗 ${src.url}`;\n\nreturn [{ json: { message: msg, chatId: src.chatId } }];"
      },
      "type": "n8n-nodes-base.code",
