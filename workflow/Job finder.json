        64
      ],
      "id": "21c59485-0f48-4703-9039-fd2deff7df88",
      "name": "Prepare Extract"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://192.168.1.102:1234/v1/chat/completions",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  model: \"qwen2.5-7b-instruct\",\n  messages: [\n    { role: \"system\", content: \"You extract job details from web page text. You follow the output format EXACTLY. No markdown, no extra text.\" },\n    { role: \"user\", content: \"CANDIDATE PROFILE:\\nEntry-level developer. Wants: automation, n8n, workflow tools, junior developer, QA automation. NOT senior/lead roles. Remote, Europe timezone.\\n\\nJOB PAGE TEXT:\\n\" + $json.text + \"\\n\\nExtract the job details. Judge fit ONLY by the real title and requirements in the text above.\\nThe example lines show ONLY the format — NEVER reuse their words.\\nRespond with EXACTLY 7 lines, format LABEL|value:\\nTITLE|the job title\\nCOMPANY|the company name\\nSALARY|salary or not listed\\nLOCATION|locations or not listed\\nTYPE|employment type or not listed\\nFIT|score 0-100 for the candidate profile\\nVERDICT|one short sentence: fit or not fit, and why\\nNo other text.\" }\n  ],\n  temperature: 0.2,\n  max_tokens: 800\n}) }}",
        "options": {
          "timeout": 120000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        896,
