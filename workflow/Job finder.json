    {
      "parameters": {
        "jsCode": "// 1. Jina's full page text\nconst raw = $json.data || '';\n\n// 2. Cut the useful window:\n//    job content lives between \"Markdown Content:\" and \"Similar Remote Jobs\"\nlet text = raw;\nconst start = text.indexOf('Markdown Content:');\nif (start !== -1) text = text.slice(start);\nconst end = text.indexOf('Similar Remote Jobs');\nif (end !== -1) text = text.slice(0, end);\n\n// 3. Squeeze whitespace + cap size (context window safety)\ntext = text.replace(/\\s+/g, ' ').trim().slice(0, 3500);\n\n// 4. Bring chatId + url from the entry point\nconst src = $('Route Command').first().json;\n\nreturn [{ json: { text, chatId: src.chatId, url: src.url } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
