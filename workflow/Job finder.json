        "jsCode": "const msg = $json.message;\nconst text = (msg.text || '').trim();\nconst urlMatch = text.match(/https?:\\/\\/\\S+/);\n\nlet type = 'chat';\nlet url = null;\nlet query = null;\n\nif (urlMatch) {\n  type = 'job';\n  url = urlMatch[0];\n} else if (/^\\/?find\\b/i.test(text)) {\n  type = 'find';\n  query = text.replace(/^\\/?find\\s*/i, '').trim() || 'automation';\n}\n\nreturn [{ json: { type, url, query, text, chatId: msg.chat.id } }];"
      },
