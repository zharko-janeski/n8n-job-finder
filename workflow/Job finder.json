    {
      "parameters": {
        "jsCode": "const all = $('Remotive Search').first().json.jobs || [];\n\n// URLs already in the Sheet = already seen\nconst seen = new Set($('Get Seen URLs').all().map(i => (i.json.URL || '').trim()));\nconst fresh = all.filter(j => !seen.has(j.url));\nconst top = fresh.slice(0, 10); // cap 10 — model-friendly batch\n\nconst profile = `Entry-level developer. Wants: automation, n8n, workflow tools, junior developer, QA automation, integrations. NOT senior/lead roles. Remote, Europe timezone.`;\n\nif (top.length === 0) {\n  return [{ json: { empty: true, chatId: $('Route Command').first().json.chatId, query: $('Route Command').first().json.query } }];\n}\n\nconst listing = top.map((j, i) => {\n  const desc = (j.description || '').replace(/<[^>]+>/g, ' ').replace(/\\s+/g, ' ').slice(0, 400);\n  return `[${i}] ${j.title} at ${j.company_name} | ${j.candidate_required_location || 'Remote'}\\n${desc}`;\n}).join('\\n\\n');\n\nreturn [{ json: {\n  listing,\n  profile,\n  count: top.length,\n  jobs: top.map(j => ({ title: j.title, company: j.company_name, location: j.candidate_required_location || 'Remote', url: j.url })),\n  chatId: $('Route Command').first().json.chatId,\n  query: $('Route Command').first().json.query\n}}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
