      "id": "a0b793c9-0dd7-40a1-8ee5-06869d762ee2",
      "name": "Has New Jobs?"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://192.168.1.102:1234/v1/chat/completions",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  model: \"qwen2.5-7b-instruct\",\n  messages: [\n    { role: \"system\", content: \"You score job listings for a candidate. You follow the output format EXACTLY. No markdown, no extra text.\" },\n    { role: \"user\", content: \"CANDIDATE PROFILE:\\n\" + $json.profile + \"\\n\\nJOB LISTINGS:\\n\" + $json.listing + \"\\n\\nScore each job from [0] to [\" + ($json.count - 1) + \"] from 0-100 for fit. Judge ONLY by each job's real title and description. Senior/lead roles = low score.\\nThe example lines show ONLY the format — NEVER reuse their numbers or words.\\nRespond with EXACTLY \" + $json.count + \" lines, format i|score|short-reason-specific-to-that-job, e.g.:\\n0|15|reason for job 0\\n1|70|reason for job 1\\nNo other text.\" }\n  ],\n  temperature: 0.2,\n  max_tokens: 800\n}) }}",
        "options": {
          "timeout": 120000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1088,
        -112
      ],
      "id": "41359e48-fbc0-42e8-a339-ad568e3a3aaa",
      "name": "Qwen Score Jobs"
    },
    {
      "parameters": {
        "jsCode": "// 1. Read Qwen's raw answer\nconst raw = ($json.choices[0].message.content || '').trim();\n\n// 2. Parse lines in format: i|score|reason (ignores any prose around them)\nconst scores = raw\n  .split('\\n')\n  .map(l => l.trim())\n  .filter(l => /^\\d+\\s*\\|/.test(l))\n  .map(l => {\n    const parts = l.split('|');\n    return {\n      i: parseInt(parts[0], 10),\n      score: parseInt(parts[1], 10) || 0,\n      reason: (parts.slice(2).join('|') || '').trim().slice(0, 60)\n    };\n  })\n  .filter(s => !isNaN(s.i));\n\nif (scores.length === 0) {\n  throw new Error('Qwen ignored the format. Raw answer: ' + raw.slice(0, 300));\n}\n\n// 3. Merge with jobs, sort best first\nconst prev = $('Prepare Scoring').first().json;\nconst jobs = prev.jobs || [];\n\nconst ranked = scores\n  .map(s => {\n    const job = jobs[s.i] || { title: '?', company: '?', url: '' };\n    return { score: s.score, reason: s.reason, ...job };\n  })\n  .sort((a, b) => b.score - a.score);\n\n// 4. Phone-friendly message\nconst lines = ranked.map(r => {\n  const emoji = r.score >= 70 ? '🟢' : r.score >= 40 ? '🟡' : '🔴';\n  return `${emoji} ${r.score}/100 — ${r.title} (${r.company})\\n   💬 ${r.reason}\\n   🔗 ${r.url}`;\n});\n\nconst msg = `🤖 Ranked for \"${prev.query}\" — best fit first:\\n\\n` + lines.join('\\n\\n');\n\nreturn [{ json: { message: msg, chatId: prev.chatId, ranked } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1344,
        -112
      ],
      "id": "87239b44-a285-4eab-847c-0c6d0cf1b65a",
      "name": "Merge & Rank"
    },
    {
      "parameters": {
        "jsCode": "const ranked = $json.ranked || [];\nconst today = new Date().toISOString().slice(0, 10);\nconst query = $('Prepare Scoring').first().json.query;\n\nreturn ranked.map(r => ({ json: {\n  Date: today,\n  Query: query,\n  Score: r.score,\n  Title: r.title,\n  Company: r.company,\n  Location: r.location || 'Remote',\n  URL: r.url,\n  Reason: r.reason\n}}));"
      },
